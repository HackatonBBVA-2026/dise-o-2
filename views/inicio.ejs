<%- include('partials/head') %>
<%
  const pos = (d) => (((d - 1) / (r.cierreMes - 1)) * 100).toFixed(2);
  const colores = ['var(--cat-1)', 'var(--cat-2)', 'var(--cat-3)', 'var(--cat-4)', 'var(--cat-5)'];
  const colorCat = (c, i) => c.alerta ? 'var(--cat-alerta)' : colores[i % colores.length];
  const [entero, decimales] = soles(r.disponible).replace('S/ ', '').split('.');
%>

<header class="topbar">
  <a class="tier" href="/app/perfil" aria-label="Ir a tu perfil <%= usuario.nivel %>">
    <span class="avatar avatar--sm"><%= usuario.nombre[0] %><%= usuario.apellido[0] %></span>
    <span class="tier__text">
      <span class="eyebrow"><%= usuario.nivel %></span>
      <span class="tier__hello"><%= saludoHora %>, <%= usuario.nombre %></span>
    </span>
  </a>
  <a class="icon-btn" href="/app/operaciones#movimientos" aria-label="Buscar movimientos">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  </a>
</header>

<div class="grid">

  <%# Tarjeta virtual %>
  <figure class="card-v" aria-label="Tarjeta de <%= tarjeta.tipo.toLowerCase() %> terminada en <%= tarjeta.ultimos %>">
    <div class="card-v__top">
      <span class="card-v__brand">BOOT</span>
      <span class="card-v__tier">BLACK<small><%= tarjeta.tipo.toUpperCase() %></small></span>
    </div>
    <div class="card-v__mid" aria-hidden="true">
      <svg class="card-v__chip" viewBox="0 0 44 34"><rect x=".75" y=".75" width="42.5" height="32.5" rx="6" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M15 1v9.5H1M15 33v-9.5H1M29 1v9.5h14M29 33v-9.5h14M15 10.5h14v13H15z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
      <svg class="card-v__nfc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M8 8.5a5 5 0 0 1 0 7M11.5 6a8.5 8.5 0 0 1 0 12M15 3.5a12 12 0 0 1 0 17"/></svg>
    </div>
    <p class="card-v__number emboss">•••• •••• •••• <%= tarjeta.ultimos %></p>
    <div class="card-v__bottom">
      <span><small>Titular</small><b class="emboss"><%= tarjeta.titular %></b></span>
      <span><small>Vence</small><b class="emboss"><%= tarjeta.vence %></b></span>
    </div>
  </figure>

  <%# Balance: tocar para ocultar %>
  <section class="balance" aria-labelledby="saldoTitle">
    <button type="button" class="balance__toggle" data-toggle-saldos aria-pressed="false">
      <span class="eyebrow" id="saldoTitle">
        Saldo disponible
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.8"/></svg>
      </span>
      <span class="balance__amount money"><span class="cur">S/</span><%= entero %><span class="dec">.<%= decimales %></span></span>
      <span class="sr-only">Toca para ocultar o mostrar tus saldos</span>
    </button>

    <div class="balance__proj">
      <div>
        <span class="eyebrow">Proyección al <%= r.cierreMes %> nov</span>
        <strong class="money gold"><%= soles(Math.round(r.proyeccion.saldo)) %></strong>
      </div>
      <span class="status status--<%= r.semaforo.nivel %>"><%= r.semaforo.texto %></span>
    </div>

    <div class="month" role="img" aria-label="Día <%= r.hoy %> de <%= r.cierreMes %>. Cobros pendientes los días <%= r.proximosCobros.map(c => c.dia).join(', ') %>.">
      <div class="month__track">
        <span class="month__done" style="width:<%= pos(r.hoy) %>%"></span>
        <% r.proximosCobros.forEach(c => { %><span class="month__tick" style="left:<%= pos(c.dia) %>%" title="<%= c.nombre %> · día <%= c.dia %>"></span><% }) %>
        <span class="month__today" style="left:<%= pos(r.hoy) %>%"></span>
      </div>
      <div class="month__labels" aria-hidden="true">
        <span style="left:0">01</span>
        <span class="is-today" style="left:<%= pos(r.hoy) %>%">Hoy</span>
        <% r.proximosCobros.forEach(c => { %><span style="left:<%= pos(c.dia) %>%"><%= c.dia %></span><% }) %>
        <span style="left:100%"><%= r.cierreMes %></span>
      </div>
    </div>
  </section>

  <%# Accesos rápidos a Operaciones %>
  <nav class="quick span-2" aria-label="Accesos rápidos">
    <a class="quick__item" href="/app/operaciones#transferir">
      <span class="quick__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14m0 0-3.5-3.5M19 8l-3.5 3.5M19 16H5m0 0 3.5-3.5M5 16l3.5 3.5"/></svg></span>
      Transferir
    </a>
    <a class="quick__item" href="/app/operaciones#qr">
      <span class="quick__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><path d="M14 14h2.5v2.5H14zM20 14v.01M14 20h.01M17 20h3v-3"/></svg></span>
      Pagar QR
    </a>
    <a class="quick__item" href="/app/operaciones#cambio">
      <span class="quick__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M12 4v16M15.5 7.5c0-1.4-1.6-2.5-3.5-2.5s-3.5 1.1-3.5 2.5S10 10 12 10.5s3.5 1.2 3.5 2.8-1.6 2.7-3.5 2.7-3.5-1.1-3.5-2.5"/></svg></span>
      T-Cambio
    </a>
    <a class="quick__item" href="/app/operaciones#movimientos">
      <span class="quick__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M5 7h14M5 12h14M5 17h9"/></svg></span>
      Movimientos
    </a>
  </nav>

  <%# Acceso a Avisos (la lista completa vive en su pestaña) %>
  <% if (r.alertas.length) { %>
  <a class="alert-link span-2" href="/app/avisos" data-avisos>
    <span class="alert-link__mark"><%- include('partials/boot-avatar') %></span>
    <span class="alert-link__text"><strong>Boot encontró <%= r.alertas.length %> aviso<%= r.alertas.length > 1 ? 's' : '' %></strong><small><%= r.alertas.map(x => x.titulo).join(' · ') %></small></span>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
  </a>
  <% } %>

  <%# Flujo del mes %>
  <section class="panel" aria-labelledby="mesTitle">
    <header class="panel__head">
      <h2 class="eyebrow" id="mesTitle">Noviembre</h2>
      <a class="link" href="/app/operaciones#movimientos">Movimientos</a>
    </header>
    <dl class="ledger">
      <div><dt>Ingresos</dt><dd class="money pos">+ <%= soles(r.ingresos) %></dd></div>
      <div><dt>Gastos</dt><dd class="money"><%= soles(-r.gastos) %></dd></div>
      <div class="ledger__total"><dt>Te sobra</dt><dd class="money"><%= soles(r.neto) %></dd></div>
    </dl>
    <div class="ratio" aria-hidden="true"><span style="width:<%= r.pctGasto %>%"></span></div>
    <p class="hint">Gastaste <%= r.pctGasto %> de cada 100 soles que ingresaron.</p>
  </section>

  <%# Gasto por categoría %>
  <section class="panel" aria-labelledby="catTitle">
    <header class="panel__head"><h2 class="eyebrow" id="catTitle">¿En qué se va tu plata?</h2></header>
    <div class="stack" aria-hidden="true">
      <% r.categorias.forEach((c, i) => { %><span style="width:<%= c.pct %>%;background:<%= colorCat(c, i) %>"></span><% }) %>
    </div>
    <ul class="legend">
      <% r.categorias.forEach((c, i) => { %>
        <li>
          <span class="swatch" style="background:<%= colorCat(c, i) %>"></span>
          <span class="legend__name"><%= c.nombre %><% if (c.alerta) { %> <em class="tag tag--warn">revisar</em><% } %></span>
          <span class="legend__pct"><%= Math.round(c.pct) %>%</span>
          <span class="money"><%= soles(c.monto) %></span>
        </li>
      <% }) %>
    </ul>
  </section>

  <%# Próximos cobros + cuentas %>
  <section class="panel" aria-labelledby="cobrosTitle">
    <header class="panel__head">
      <h2 class="eyebrow" id="cobrosTitle">Próximos cobros</h2>
      <span class="count money"><%= soles(-r.proyeccion.pendientes) %></span>
    </header>
    <ul class="rows">
      <% r.proximosCobros.forEach(c => { %>
        <li>
          <span class="date"><b><%= c.dia %></b>nov</span>
          <span class="rows__name"><%= c.nombre %></span>
          <span class="money"><%= soles(-c.monto) %></span>
        </li>
      <% }) %>
    </ul>
    <header class="panel__head panel__head--sub"><h2 class="eyebrow">Cuentas</h2></header>
    <ul class="rows">
      <% r.cuentas.forEach(c => { %>
        <li>
          <span class="rows__name"><%= c.tipo %><small>•••• <%= c.numero %></small></span>
          <span class="money"><%= soles(c.saldo) %></span>
        </li>
      <% }) %>
    </ul>
  </section>

  <%# Acceso directo a Boot %>
  <section class="panel panel--ask span-2" aria-labelledby="askTitle">
    <header class="panel__head"><h2 class="eyebrow" id="askTitle">Antes de gastar, pregúntale a Boot</h2></header>
    <p class="hint">Boot hace la cuenta con tus movimientos y te dice cómo quedarías el <%= r.cierreMes %>.</p>
    <div class="asks">
      <button type="button" class="ask" data-ask="¿Puedo gastar S/ 200 en unas zapatillas?">¿Puedo gastar S/ 200 en unas zapatillas?</button>
      <button type="button" class="ask" data-ask="¿Me alcanza para un préstamo de S/ 3,000?">¿Me alcanza para un préstamo de S/ 3,000?</button>
      <button type="button" class="ask" data-ask="Fondo de emergencia">¿Cuánto debería tener de fondo de emergencia?</button>
    </div>
  </section>

</div>

<%- include('partials/foot') %>
