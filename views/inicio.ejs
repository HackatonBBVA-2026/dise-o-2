<%- include('partials/head') %>
<%
  const pos = (d) => (((d - 1) / (r.cierreMes - 1)) * 100).toFixed(2);
  const colores = ['var(--cat-1)', 'var(--cat-2)', 'var(--cat-3)', 'var(--cat-4)', 'var(--cat-5)'];
  const colorCat = (c, i) => c.alerta ? 'var(--cat-alerta)' : colores[i % colores.length];
  const iconos = {
    aviso: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4.5l3 1.8"/>',
    peligro: '<path d="M12 4 3 20h18z"/><path d="M12 10v4M12 17v.01"/>',
    duplicado: '<rect x="4" y="7" width="11" height="13" rx="2"/><path d="M9 4h9a2 2 0 0 1 2 2v11"/>',
  };
%>

<header class="pagehead">
  <div>
    <p class="pagehead__eyebrow">Sábado 14 de noviembre</p>
    <h1>Hola, <%= usuario.nombre %></h1>
  </div>
  <button type="button" class="icon-btn" data-toggle-saldos aria-label="Mostrar u ocultar saldos" title="Ocultar saldos">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.8"/></svg>
  </button>
</header>

<div class="grid">

  <%# Saldo + mes en una línea de tiempo: el único bloque azul de la página %>
  <section class="balance span-2" aria-labelledby="saldoTitle">
    <div class="balance__main">
      <div>
        <h2 class="balance__label" id="saldoTitle">Disponible en tus cuentas</h2>
        <p class="balance__amount money"><%= soles(r.disponible) %></p>
      </div>
      <div class="balance__proj">
        <span class="balance__label">Te quedaría el <%= r.cierreMes %> nov</span>
        <strong class="money"><%= soles(Math.round(r.proyeccion.saldo)) %></strong>
        <span class="status status--<%= r.semaforo.nivel %>"><%= r.semaforo.texto %></span>
      </div>
    </div>

    <div class="month" role="img" aria-label="Día <%= r.hoy %> de <%= r.cierreMes %>. Cobros pendientes los días <%= r.proximosCobros.map(c => c.dia).join(', ') %>.">
      <div class="month__track">
        <span class="month__done" style="width:<%= pos(r.hoy) %>%"></span>
        <% r.proximosCobros.forEach(c => { %>
          <span class="month__tick" style="left:<%= pos(c.dia) %>%" title="<%= c.nombre %> · día <%= c.dia %>"></span>
        <% }) %>
        <span class="month__today" style="left:<%= pos(r.hoy) %>%"></span>
      </div>
      <div class="month__labels" aria-hidden="true">
        <span style="left:0">1 · sueldo</span>
        <span class="is-today" style="left:<%= pos(r.hoy) %>%">hoy</span>
        <% r.proximosCobros.forEach(c => { %><span style="left:<%= pos(c.dia) %>%"><%= c.dia %></span><% }) %>
        <span style="left:100%"><%= r.cierreMes %></span>
      </div>
    </div>
  </section>

  <%# Avisos de Boot %>
  <% if (r.alertas.length) { %>
  <section class="panel" aria-labelledby="avisosTitle" data-avisos>
    <header class="panel__head">
      <h2 id="avisosTitle">Boot revisó tu mes</h2>
      <span class="count"><%= r.alertas.length %> aviso<%= r.alertas.length > 1 ? 's' : '' %></span>
    </header>
    <ul class="notices">
      <% r.alertas.forEach(a => { %>
        <li class="notice notice--<%= a.tipo %>">
          <span class="notice__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- iconos[a.tipo] %></svg></span>
          <div class="notice__body">
            <strong><%= a.titulo %></strong>
            <p><%= a.texto %></p>
          </div>
          <button type="button" class="btn-sm" data-ask="<%= a.pregunta %>">Revisar</button>
        </li>
      <% }) %>
    </ul>
  </section>
  <% } %>

  <%# Flujo del mes %>
  <section class="panel" aria-labelledby="mesTitle">
    <header class="panel__head">
      <h2 id="mesTitle">Noviembre</h2>
      <a class="link" href="/app/operaciones#movimientos">Movimientos</a>
    </header>
    <dl class="ledger">
      <div><dt>Ingresos</dt><dd class="money pos">+ <%= soles(r.ingresos) %></dd></div>
      <div><dt>Gastos</dt><dd class="money"><%= soles(-r.gastos) %></dd></div>
      <div class="ledger__total"><dt>Te sobra</dt><dd class="money"><%= soles(r.neto) %></dd></div>
    </dl>
    <div class="ratio" aria-hidden="true"><span style="width:<%= r.pctGasto %>%"></span></div>
    <p class="hint">Gastaste <%= r.pctGasto %> de cada 100 soles que ingresaron.</p>
  </section>

  <%# Gasto por categoría: una barra apilada que suma 100 %>
  <section class="panel" aria-labelledby="catTitle">
    <header class="panel__head">
      <h2 id="catTitle">¿En qué se va tu plata?</h2>
    </header>
    <div class="stack" aria-hidden="true">
      <% r.categorias.forEach((c, i) => { %><span style="width:<%= c.pct %>%;background:<%= colorCat(c, i) %>"></span><% }) %>
    </div>
    <ul class="legend">
      <% r.categorias.forEach((c, i) => { %>
        <li>
          <span class="swatch" style="background:<%= colorCat(c, i) %>"></span>
          <span class="legend__name"><%= c.nombre %><% if (c.alerta) { %> <em class="tag tag--warn">revisar</em><% } %></span>
          <span class="legend__pct"><%= Math.round(c.pct) %>%</span>
          <span class="money"><%= soles(c.monto) %></span>
        </li>
      <% }) %>
    </ul>
  </section>

  <%# Próximos cobros + cuentas %>
  <section class="panel" aria-labelledby="cobrosTitle">
    <header class="panel__head">
      <h2 id="cobrosTitle">Próximos cobros</h2>
      <span class="count"><%= soles(-r.proyeccion.pendientes) %></span>
    </header>
    <ul class="rows">
      <% r.proximosCobros.forEach(c => { %>
        <li>
          <span class="date"><b><%= c.dia %></b>nov</span>
          <span class="rows__name"><%= c.nombre %></span>
          <span class="money"><%= soles(-c.monto) %></span>
        </li>
      <% }) %>
    </ul>

    <header class="panel__head panel__head--sub">
      <h2>Cuentas</h2>
    </header>
    <ul class="rows">
      <% r.cuentas.forEach(c => { %>
        <li>
          <span class="rows__name"><%= c.tipo %><small class="mono">•••• <%= c.numero %></small></span>
          <span class="money"><%= soles(c.saldo) %></span>
        </li>
      <% }) %>
    </ul>
  </section>

  <%# Acceso directo a Boot %>
  <section class="panel panel--ask span-2" aria-labelledby="askTitle">
    <header class="panel__head">
      <h2 id="askTitle">Antes de gastar, pregúntale a Boot</h2>
    </header>
    <p class="hint">Boot hace la cuenta con tus movimientos reales y te dice cómo quedarías el <%= r.cierreMes %>.</p>
    <div class="asks">
      <button type="button" class="ask" data-ask="¿Puedo gastar S/ 200 en unas zapatillas?">¿Puedo gastar S/ 200 en unas zapatillas?</button>
      <button type="button" class="ask" data-ask="¿Me alcanza para un préstamo de S/ 3,000?">¿Me alcanza para un préstamo de S/ 3,000?</button>
      <button type="button" class="ask" data-ask="Fondo de emergencia">¿Cuánto debería tener de fondo de emergencia?</button>
    </div>
  </section>

</div>

<%- include('partials/foot', { saludo: r.duplicados.length ? 'Encontré un cobro duplicado. ¿Lo revisamos?' : '' }) %>
