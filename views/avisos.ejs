<%- include('partials/head') %>
<%
  const iconos = {
    aviso: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4.5l3 1.8"/>',
    peligro: '<path d="M12 4 3 20h18z"/><path d="M12 10v4M12 17v.01"/>',
    duplicado: '<rect x="4" y="7" width="11" height="13" rx="2"/><path d="M9 4h9a2 2 0 0 1 2 2v11"/>',
    seguridad: '<path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6z"/>',
  };
%>

<header class="pagehead">
  <div>
    <p class="pagehead__eyebrow"><%= r.alertas.length %> por revisar</p>
    <h1>Avisos</h1>
  </div>
</header>

<div class="grid">
  <section class="panel" aria-labelledby="bootAvisos" data-avisos>
    <header class="panel__head">
      <h2 id="bootAvisos">Boot revisó tu mes</h2>
      <span class="count">Nuevo</span>
    </header>
    <ul class="notices">
      <% r.alertas.forEach(a => { %>
        <li class="notice notice--<%= a.tipo %>">
          <span class="notice__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- iconos[a.tipo] %></svg></span>
          <div class="notice__body">
            <strong><%= a.titulo %></strong>
            <p><%= a.texto %></p>
          </div>
          <button type="button" class="btn-sm" data-ask="<%= a.pregunta %>">Revisar</button>
        </li>
      <% }) %>
    </ul>
  </section>

  <section class="panel" aria-labelledby="cobrosTitle">
    <header class="panel__head">
      <h2 id="cobrosTitle">Próximos cobros</h2>
      <span class="count money"><%= soles(-r.proyeccion.pendientes) %></span>
    </header>
    <ul class="rows">
      <% r.proximosCobros.forEach(c => { %>
        <li>
          <span class="date"><b><%= c.dia %></b>nov</span>
          <span class="rows__name"><%= c.nombre %><small>En <%= c.dia - r.hoy %> días</small></span>
          <span class="money"><%= soles(-c.monto) %></span>
        </li>
      <% }) %>
    </ul>
  </section>

  <section class="panel" aria-labelledby="segTitle">
    <header class="panel__head"><h2 id="segTitle">Seguridad</h2></header>
    <ul class="notices">
      <% seguridad.forEach(s => { %>
        <li class="notice notice--seguridad">
          <span class="notice__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- iconos.seguridad %></svg></span>
          <div class="notice__body">
            <strong><%= s.titulo %></strong>
            <p><%= s.detalle %> · <%= s.cuando %></p>
          </div>
          <button type="button" class="btn-sm" data-demo="¿No fuiste tú? Bloquear acceso">¿No fuiste tú?</button>
        </li>
      <% }) %>
    </ul>
  </section>
</div>

<%- include('partials/foot') %>
