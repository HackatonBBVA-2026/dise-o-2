<%- include('partials/head') %>

<section class="chat" id="bootPage" aria-labelledby="bootTitle">
  <header class="chat__head">
    <span class="chat__avatar"><%- include('partials/boot-avatar') %></span>
    <div>
      <h1 id="bootTitle">Boot</h1>
      <p><span class="live-dot" aria-hidden="true"></span>Asistente con IA · en línea</p>
    </div>
  </header>

  <div class="chat__log" id="bootLog" aria-live="polite"></div>

  <div class="chat__chips" id="bootChips">
    <button type="button" class="chip">¿Llego a fin de mes?</button>
    <button type="button" class="chip">¿Puedo gastar S/ 200 en unas zapatillas?</button>
    <button type="button" class="chip">¿Y el cobro duplicado?</button>
    <button type="button" class="chip">Mis suscripciones</button>
  </div>

  <form class="chat__form" id="bootForm" autocomplete="off">
    <label class="sr-only" for="bootInput">Escribe tu pregunta</label>
    <input id="bootInput" type="text" placeholder="Pregúntale a Boot" maxlength="300">
    <button type="submit" aria-label="Enviar">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
  </form>
  <p class="chat__legal">Información y simulaciones, no asesoría. La decisión es tuya.</p>
</section>

<%- include('partials/foot') %>
