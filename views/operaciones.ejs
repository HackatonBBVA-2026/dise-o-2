<%- include('partials/head') %>

<header class="pagehead">
  <div>
    <p class="pagehead__eyebrow">Disponible <span class="money"><%= soles(r.disponible) %></span></p>
    <h1>Operaciones</h1>
  </div>
</header>

<div class="ops">
  <div class="tabs" role="tablist" aria-label="Tipo de operación">
    <button class="tab" role="tab" id="tab-movimientos" aria-controls="movimientos" data-panel="movimientos">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h9"/></svg>
      <span>Movimientos</span>
    </button>
    <button class="tab" role="tab" id="tab-transferir" aria-controls="transferir" data-panel="transferir">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14m0 0-3.5-3.5M19 8l-3.5 3.5M19 16H5m0 0 3.5-3.5M5 16l3.5 3.5"/></svg>
      <span>Transferir</span>
    </button>
    <button class="tab" role="tab" id="tab-qr" aria-controls="qr" data-panel="qr">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><path d="M14 14h2.5v2.5H14zM20 14v.01M14 20h.01M17 20h3v-3"/></svg>
      <span>Pagos QR</span>
    </button>
    <button class="tab" role="tab" id="tab-cambio" aria-controls="cambio" data-panel="cambio">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M12 4v16M15.5 7.5c0-1.4-1.6-2.5-3.5-2.5s-3.5 1.1-3.5 2.5S10 10 12 10.5s3.5 1.2 3.5 2.8-1.6 2.7-3.5 2.7-3.5-1.1-3.5-2.5"/></svg>
      <span>T-Cambio</span>
    </button>
  </div>

  <%# Movimientos %>
  <section class="panel tabpanel" id="movimientos" role="tabpanel" aria-labelledby="tab-movimientos">
    <header class="panel__head">
      <h2>Movimientos de noviembre</h2>
      <span class="count"><%= r.movimientos.length %></span>
    </header>
    <div class="filters">
      <label class="sr-only" for="buscarMov">Buscar movimiento</label>
      <input class="input" id="buscarMov" type="search" placeholder="Buscar comercio o categoría">
      <div class="seg" role="group" aria-label="Filtrar">
        <button type="button" class="seg__btn is-active" data-filtro="todos">Todos</button>
        <button type="button" class="seg__btn" data-filtro="in">Ingresos</button>
        <button type="button" class="seg__btn" data-filtro="out">Gastos</button>
      </div>
    </div>
    <ul class="rows" id="listaMov">
      <% const dup = new Set(r.duplicados.map(d => d.comercio)); %>
      <% r.movimientos.forEach(m => { %>
        <li class="mov" data-tipo="<%= m.monto > 0 ? 'in' : 'out' %>" data-texto="<%= (m.descripcion + ' ' + m.categoria).toLowerCase() %>">
          <span class="date"><b><%= m.dia %></b>nov</span>
          <span class="rows__name"><%= m.descripcion %>
            <small><%= m.categoria %><% if (dup.has(m.descripcion)) { %> · <em class="tag tag--warn">posible duplicado</em><% } %></small>
          </span>
          <span class="money <%= m.monto > 0 ? 'pos' : '' %>"><%= m.monto > 0 ? '+ ' : '' %><%= soles(m.monto) %></span>
        </li>
      <% }) %>
    </ul>
    <p class="hint empty" id="movVacio" hidden>Ningún movimiento coincide con tu búsqueda.</p>
  </section>

  <%# Transferir %>
  <section class="panel tabpanel" id="transferir" role="tabpanel" aria-labelledby="tab-transferir" hidden>
    <header class="panel__head"><h2>Transferir</h2></header>
    <form id="formTransfer" class="form" novalidate>
      <div class="field">
        <label for="tCuenta">Desde</label>
        <select class="input" id="tCuenta" name="cuentaId">
          <% cuentas.forEach(c => { %>
            <option value="<%= c.id %>">Ahorros •••• <%= c.numero %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="tDestino">Cuenta destino o CCI</label>
        <input class="input mono" id="tDestino" name="destino" inputmode="numeric" placeholder="002 191 001234567890 54" required>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="tMonto">Monto</label>
          <div class="input-affix"><span>S/</span><input class="input" id="tMonto" name="monto" type="number" min="0.01" step="0.01" placeholder="0.00" required></div>
        </div>
        <div class="field">
          <label for="tDesc">Descripción <small>opcional</small></label>
          <input class="input" id="tDesc" name="descripcion" maxlength="40" placeholder="Alquiler">
        </div>
      </div>
      <p class="form__error" id="transferError" role="alert" hidden></p>
      <div class="form__actions">
        <button class="btn" type="submit">Continuar</button>
        <button class="btn btn--ghost" type="button" data-ask-monto>¿Me alcanza? Preguntar a Boot</button>
      </div>
    </form>
  </section>

  <%# Pagos QR %>
  <section class="panel tabpanel" id="qr" role="tabpanel" aria-labelledby="tab-qr" hidden>
    <header class="panel__head"><h2>Pagos QR</h2></header>
    <div class="qr">
      <div class="qr__frame" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      <div class="qr__actions">
        <p class="hint">Apunta la cámara al QR del comercio. Verás el monto y el nombre antes de confirmar.</p>
        <button class="btn" type="button" data-demo="Escanear QR">Escanear QR</button>
        <button class="btn btn--ghost" type="button" data-demo="Mi QR para cobrar">Mostrar mi QR para cobrar</button>
      </div>
    </div>
  </section>

  <%# Tipo de cambio %>
  <section class="panel tabpanel" id="cambio" role="tabpanel" aria-labelledby="tab-cambio" hidden>
    <header class="panel__head"><h2>Tipo de cambio</h2><span class="count">referencial</span></header>
    <dl class="fx">
      <div><dt>Compra</dt><dd class="money">S/ <%= tipoCambio.compra.toFixed(3) %></dd></div>
      <div><dt>Venta</dt><dd class="money">S/ <%= tipoCambio.venta.toFixed(3) %></dd></div>
    </dl>
    <form class="form" id="formCambio" data-compra="<%= tipoCambio.compra %>" data-venta="<%= tipoCambio.venta %>">
      <div class="seg" role="group" aria-label="Operación">
        <button type="button" class="seg__btn is-active" data-modo="comprar">Quiero dólares</button>
        <button type="button" class="seg__btn" data-modo="vender">Quiero soles</button>
      </div>
      <div class="field">
        <label for="fxIn" id="fxLabelIn">Envías (S/)</label>
        <input class="input" id="fxIn" type="number" min="0" step="0.01" value="100">
      </div>
      <p class="fx__out">Recibes <strong class="money" id="fxOut">—</strong></p>
      <button class="btn" type="button" data-demo="Cambio de moneda">Cambiar</button>
    </form>
  </section>
</div>

<%- include('partials/foot', { scripts: ['/js/operaciones.js'] }) %>
