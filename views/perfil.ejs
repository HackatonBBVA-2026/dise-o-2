<%- include('partials/head') %>

<header class="pagehead pagehead--profile">
  <span class="avatar" aria-hidden="true"><%= usuario.nombre[0] %><%= usuario.apellido[0] %></span>
  <div>
    <p class="pagehead__eyebrow"><span class="gold"><%= usuario.nivel %></span> · Cliente desde <%= usuario.clienteDesde %></p>
    <h1><%= usuario.nombre %> <%= usuario.apellido %></h1>
  </div>
</header>

<div class="grid">
  <section class="panel" aria-labelledby="cuentaTitle">
    <header class="panel__head"><h2 id="cuentaTitle">Mi cuenta</h2></header>
    <ul class="rows">
      <li><span class="rows__name">Correo</span><span class="muted"><%= usuario.email %></span></li>
      <li><span class="rows__name">Celular</span><span class="muted mono"><%= usuario.telefono %></span></li>
      <li><button type="button" class="row-btn" data-demo="Editar datos personales">Datos personales<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></li>
    </ul>
  </section>

  <section class="panel" aria-labelledby="ajustesTitle">
    <header class="panel__head"><h2 id="ajustesTitle">Ajustes</h2></header>
    <ul class="rows">
      <li>
        <label class="rows__name" for="optSaldos">Ocultar saldos<small>Muestra puntos en lugar de montos</small></label>
        <input type="checkbox" class="switch" id="optSaldos" data-pref="ocultarSaldos">
      </li>
      <li>
        <label class="rows__name" for="optAvisos">Alertas de Boot<small>Punto en la pestaña Avisos e Inicio</small></label>
        <input type="checkbox" class="switch" id="optAvisos" data-pref="avisosBoot" checked>
      </li>
      <li>
        <label class="rows__name" for="optPush">Notificaciones push<small>Cada movimiento y cobro</small></label>
        <input type="checkbox" class="switch" id="optPush" data-pref="push" checked>
      </li>
    </ul>
  </section>

  <section class="panel" aria-labelledby="segTitle">
    <header class="panel__head"><h2 id="segTitle">Seguridad</h2></header>
    <ul class="rows">
      <li><button type="button" class="row-btn" data-demo="Cambiar clave">Cambiar clave de internet<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></li>
      <li><button type="button" class="row-btn" data-demo="Dispositivos vinculados">Dispositivos vinculados<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></li>
      <li><button type="button" class="row-btn" data-demo="Límites de operaciones">Límites de operaciones<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></li>
    </ul>
  </section>

  <section class="panel" aria-labelledby="ayudaTitle">
    <header class="panel__head"><h2 id="ayudaTitle">Ayuda</h2></header>
    <ul class="rows">
      <li><a class="row-btn" href="/app/boot">Escribirle a Boot<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a></li>
      <li><button type="button" class="row-btn" data-demo="Centro de ayuda">Centro de ayuda<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></li>
      <li><span class="rows__name">Banca por teléfono<small>Lunes a domingo, 24 horas</small></span><span class="mono">(01) 555-0100</span></li>
      <li><button type="button" class="row-btn" data-demo="Reportar un problema">Reportar un problema<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></li>
    </ul>
  </section>

  <div class="span-2 signout">
    <button type="button" class="btn btn--danger" data-demo="Cerrar sesión">Cerrar sesión</button>
    <p class="hint">Concepto para discusión. Datos ficticios, no es un producto oficial. v1.1</p>
  </div>
</div>

<%- include('partials/foot') %>
