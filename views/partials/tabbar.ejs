<%
  const tabs = [
    { id: 'inicio', href: '/app', label: 'Inicio',
      icon: '<path d="M4 10.2 12 4l8 6.2V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1z"/>' },
    { id: 'operaciones', href: '/app/operaciones', label: 'Operaciones',
      icon: '<path d="M5 8h14m0 0-3.5-3.5M19 8l-3.5 3.5M19 16H5m0 0 3.5-3.5M5 16l3.5 3.5"/>' },
    { id: 'boot', href: '/app/boot', label: 'Boot', centro: true },
    { id: 'avisos', href: '/app/avisos', label: 'Avisos', punto: avisosCount > 0,
      icon: '<path d="M6 10a6 6 0 0 1 12 0c0 5 2 6.5 2 6.5H4S6 15 6 10z"/><path d="M10 19.5a2 2 0 0 0 4 0"/>' },
    { id: 'perfil', href: '/app/perfil', label: 'Perfil',
      icon: '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c.6-3.4 3.4-5.5 7-5.5s6.4 2.1 7 5.5"/>' },
  ];
%>
<nav class="nav" aria-label="Navegación principal">
  <% tabs.forEach(t => { const activa = tab === t.id; %>
    <a href="<%= t.href %>" class="nav__item<%= t.centro ? ' nav__item--boot' : '' %><%= activa ? ' is-active' : '' %>" <%- activa ? 'aria-current="page"' : '' %>>
      <% if (t.centro) { %>
        <span class="nav__boot"><%- include('boot-avatar') %></span>
      <% } else { %>
        <span class="nav__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="<%= activa ? 2 : 1.5 %>" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- t.icon %></svg>
          <% if (t.punto) { %><span class="nav__dot" aria-hidden="true"></span><% } %>
        </span>
      <% } %>
      <span class="nav__label"><%= t.label %><% if (t.punto) { %><span class="sr-only"> (<%= avisosCount %> nuevos)</span><% } %></span>
    </a>
  <% }) %>
</nav>
