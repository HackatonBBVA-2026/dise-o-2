# Copia este archivo como .env.local y pon tu clave de Groq (https://console.groq.com/keys).
# .env.local está en .gitignore: nunca subas tu clave al repositorio.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_RESPALDO=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=12000

# Reporte del mes por correo (https://resend.com/api-keys). Sin clave, la app solo muestra la vista previa.
# Con el remitente de prueba onboarding@resend.dev, Resend solo entrega al correo de tu propia cuenta.
RESEND_API_KEY=
REPORTE_REMITENTE=Numa <onboarding@resend.dev>

# Notificaciones push (opcional). Genera tus claves con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto real (https:// o mailto:). Apple rechaza dominios .example y localhost.
VAPID_SUBJECT=https://github.com/tu-equipo/tu-repo
